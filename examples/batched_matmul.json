{
  "name": "broadcasted_batched_matmul",
  "target": {
    "peak_compute_gflops": 2.0,
    "memory_bandwidth_gbps": 1.0
  },
  "inputs": {
    "lhs": {"shape": [2, 1, 3, 5], "dtype": "f32"},
    "rhs": {"shape": [1, 4, 5, 7], "dtype": "f32"}
  },
  "ops": [
    {
      "name": "batched_matmul",
      "op": "matmul",
      "inputs": ["lhs", "rhs"],
      "outputs": ["result"]
    }
  ],
  "outputs": ["result"]
}
